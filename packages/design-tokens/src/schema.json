{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eocrm.com/schemas/design-tokens.json",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "tokens"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "contractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "object",
      "required": ["id", "type", "value", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$" },
        "type": {
          "type": "string",
          "enum": ["color", "dimension", "number", "fontFamily", "fontWeight", "lineHeight", "duration", "shadow", "css"]
        },
        "value": { "$ref": "#/$defs/value" },
        "outputs": { "$ref": "#/$defs/outputs" }
      },
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        { "$ref": "#/$defs/alias" },
        { "$ref": "#/$defs/themeValue" }
      ]
    },
    "alias": {
      "type": "object",
      "required": ["alias"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$" }
      },
      "additionalProperties": false
    },
    "themeValue": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/value" },
        "dark": { "$ref": "#/$defs/value" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "web": { "$ref": "#/$defs/webOutput" },
        "compose": { "$ref": "#/$defs/composeOutput" }
      },
      "additionalProperties": false
    },
    "webOutput": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^--[a-z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "composeOutput": {
      "type": "object",
      "required": ["group", "name"],
      "properties": {
        "group": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
      },
      "additionalProperties": false
    }
  }
}
