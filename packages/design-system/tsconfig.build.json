{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src", "types"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.testutil.ts", "src/_meta/**"]
}
