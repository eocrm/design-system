{
  "name": "@eocrm/design-system",
  "version": "0.0.0",
  "description": "Design system for the EOCRM product — React 19 + SCSS modules + CSS custom properties.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles/global.scss": "./src/styles/global.scss",
    "./styles/tokens.scss": "./src/styles/tokens.scss",
    "./styles/reset.scss": "./src/styles/reset.scss",
    "./styles/typography.scss": "./src/styles/typography.scss",
    "./styles/mixins.scss": "./src/styles/mixins.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "AGENTS.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/*.spec.js",
    "!src/**/*.spec.jsx"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
