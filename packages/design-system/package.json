{
  "name": "@eocrm/design-system",
  "version": "0.0.0",
  "description": "Design system for the EOCRM product — React 19 + CSS custom properties.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@eocrm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/global.css": {
      "@eocrm/source": "./src/styles/global.scss",
      "default": "./dist/styles/global.css"
    },
    "./i18n/ru": {
      "@eocrm/source": "./src/i18n/ru.ts",
      "types": "./dist/i18n/ru.d.ts",
      "import": "./dist/i18n/ru.js",
      "default": "./dist/i18n/ru.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AI-PRIMER.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lucide-react": ">=1.16.0 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.8",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "libphonenumber-js": "^1.13.7",
    "prism-react-renderer": "^2.4.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eocrm/design-tokens": "0.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "prepack": "npm run build 1>&2",
    "typecheck": "tsc --noEmit",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/build-styles.mjs && node scripts/fix-dts-specifiers.mjs",
    "test": "vitest run",
    "size": "node scripts/size-guard.mjs",
    "test:dist": "vitest run -c vitest.dist.config.ts",
    "test:watch": "vitest",
    "build:manifest": "node scripts/generate-manifest.mjs",
    "build:docs": "node scripts/generate-component-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eocrm/design-system.git",
    "directory": "packages/design-system"
  }
}
