{
  "name": "eocrm-design-system-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w playground",
    "build": "npm run build -w playground",
    "build:lib": "npm run typecheck -w @eocrm/design-system",
    "preview": "npm run preview -w playground",
    "lint:css": "stylelint \"packages/**/src/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.8.3",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-declaration-strict-value": "^1.10.7",
    "typescript": "^5.7.2"
  }
}
